---
import BaseLayout from '../layouts/BaseLayout.astro';
import { rozetyData } from "../data/galleries";
const base = import.meta.env.BASE_URL;
const imgPath = `${base}images/rozety/`;

const seriesLabels = {
  RIR: 'Rozety Inne Ręcznie',
  RNG: 'Rozety Nowe Gładkie',
  ROP: 'Rozety Ozdobne',
  RPA: 'Rozety Plastikowe',
};
function seriesLabel(f) {
  const prefix = f.substring(0, 3);
  return seriesLabels[prefix] || f;
}
---

<BaseLayout
  title="Rozety cięte wodą — JET CUTTING Adam Kołaszczyński"
  description="Galeria rozet dekoracyjnych wykonanych cięciem wodnym. Rozety ręcznie robione, gładkie, ozdobne i plastikowe — różne wzory i style do wyboru. Poprzednio High Pres & Mach."
  canonical="https://high-pres.pl/rozety/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Rozety</h1>
      <p>Dekoracyjne rozety wykonane cięciem wodą — różnorodne wzory i style</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Podgląd rozety" aria-hidden="true">
        <button class="lb-close" id="lb-close" aria-label="Zamknij podgląd">&times;</button>
        <div class="lb-nav">
          <button id="lb-prev" aria-label="Poprzednia rozeta">‹</button>
          <button id="lb-next" aria-label="Następna rozeta">›</button>
        </div>
        <img id="lb-img" src="" alt="Podgląd rozety" />
      </div>

      <!-- RIR - Rozety Inne Ręcznie -->
      {(() => {
        const groups = rozetyData;
        return groups.map((group, gi) => {
          return (
            <div style="margin-bottom:48px">
              <h3 style="margin-bottom:16px;font-size:1.1rem">{seriesLabel(group[0])} — seria {group[0].match(/^[A-Z]+(\d+)/)?.[1] || ''}</h3>
              <div data-gallery id={"g-"+gi} class="gallery-grid">
                {group.map((f) => (
                  <a href={imgPath + f} title={`Rozeta dekoracyjna cięta wodą — ${f}`}>
                    <img src={imgPath + f} alt={`Rozeta dekoracyjna cięta wodą — ${f}`} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            </div>
          );
        });
      })()}
    </div>
  </section>
</BaseLayout>