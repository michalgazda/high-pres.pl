---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const contact = {
  company: 'JET CUTTING ADAM KOŁASZCZYŃSKI',
  street: 'ul. Kolejowa 10, 33-132 Niedomice, woj. małopolskie',
  nip: '8731133493',
  regon: '320038584',
  phone1: '575 794 482',
  phone2: '14 657 50 50',
  phone1Href: '+48575794482',
  phone2Href: '+48146575050',
  email1: 'biuro@high-pres.pl',
  email2: 'biuro@mach24.pl',
  hours: 'Pon–Pt: 7:30 – 16:30',
};
---

<BaseLayout
  title="Kontakt — JET CUTTING Adam Kołaszczyński | Dane teleadresowe"
  description="JET CUTTING Adam Kołaszczyński, ul. Kolejowa 10, 33-132 Niedomice. Tel. 575 794 482. Formularz kontaktowy i dane teleadresowe. Godziny otwarcia: pon–pt 7:30–16:30. Poprzednio High Pres & Mach."
  canonical="https://high-pres.pl/kontakt/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Kontakt</h1>
      <p>Skontaktuj się z nami już dziś — jesteśmy tutaj, by pomóc</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info-box">
        <h3>Dane teleadresowe</h3>
        <div class="info-row">
          <strong>Firma</strong>
          <span>JET CUTTING ADAM KOŁASZCZYŃSKI<br /><small>Poprzednio CENTRUM OBRÓBKI WODĄ HIGH PRES</small></span>
        </div>
        <div class="info-row">
          <strong>Adres</strong>
          <span>{contact.street}</span>
        </div>
        <div class="info-row">
          <strong>NIP / REGON</strong>
          <span>{contact.nip} / {contact.regon}</span>
        </div>
        <div class="info-row">
          <strong>Telefon</strong>
          <a href={`tel:${contact.phone1Href}`}>{contact.phone1}</a><br />
          <a href={`tel:${contact.phone2Href}`}>{contact.phone2}</a>
        </div>
        <div class="info-row">
          <strong>E-mail</strong>
          <a href={`mailto:${contact.email1}`}>{contact.email1}</a><br />
          <a href={`mailto:${contact.email2}`}>{contact.email2}</a>
        </div>
        <div class="info-row">
          <strong>Strony WWW</strong>
          <a href="https://high-pres.pl">high-pres.pl</a> · <a href="https://www.mach24.pl">mach24.pl</a>
        </div>
        <div class="info-row">
          <strong>Godziny otwarcia</strong>
          <span>{contact.hours}</span>
        </div>
      </div>

      <div>
        <h3 style="margin-bottom:20px">Formularz kontaktowy</h3>
        <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="REPLACE_WITH_WEB3FORMS_KEY" />
          <input type="hidden" name="subject" value="Nowe zapytanie z high-pres.pl" />
          <input type="hidden" name="from_name" value="Formularz high-pres.pl" />
          <div class="form-row">
              <label>Imię i nazwisko *<input type="text" name="imie" placeholder="np. Anna Kowalska" required /></label>
            <label>Adres e-mail *<input type="email" name="email" placeholder="np. anna@example.com" required /></label>
          </div>
          <label>Telefon<input type="tel" name="telefon" placeholder="np. 575 794 482" /></label>
          <label>Wiadomość *<textarea name="wiadomosc" rows="6" placeholder="Materiał, wymiary, ilość…" required></textarea></label>
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <button class="btn" type="submit">Wyślij zapytanie</button>
          <p class="form-status" aria-live="polite"></p>
          <p class="form-note">Twoje dane wykorzystamy wyłącznie do odpowiedzi na zapytanie. Wysyłając formularz, akceptujesz <a href={`${base}polityka-prywatnosci/`}>politykę prywatności</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Dojazd do nas</h2>
      <p class="subtitle">ul. Kolejowa 10, 33-132 Niedomice (k. Tarnowa)</p>
      <div class="map-wrap">
        <iframe title="Mapa dojazdu do HIGH PRES Niedomice" src="https://maps.google.com/maps?q=Kolejowa%2010%2C%2033-132%20Niedomice&t=&z=14&ie=UTF8&iwloc=&output=embed" width="100%" height="400" style="border:0;border-radius:12px" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://js.hcaptcha.com/1/api.js" defer></script>