---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteRaw from '../data/site.json';
import kontaktRaw from '../data/kontakt.json';

const base = import.meta.env.BASE_URL;
const site = (siteRaw as any).site;
const k = (kontaktRaw as any).kontakt;
---

<BaseLayout
  title={`Kontakt — ${site.companyShort} | Dane teleadresowe`}
  description={`${site.companyShort}, ${site.street}, ${site.postalCode} ${site.city}. Tel. ${site.phone1}. Formularz kontaktowy i dane teleadresowe. Godziny otwarcia: pon–pt 7:30–16:30. Poprzednio ${site.previousName}.`}
  canonical="https://high-pres.pl/kontakt/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Kontakt</h1>
      <p>Skontaktuj się z nami już dziś — jesteśmy tutaj, by pomóc</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info-box">
        <h3>Dane teleadresowe</h3>
        <div class="info-row">
          <strong>Firma</strong>
          <span>{site.company}<br /><small>Poprzednio {site.previousNameLong}</small></span>
        </div>
        <div class="info-row">
          <strong>Adres</strong>
          <span>{site.street}</span>
        </div>
        <div class="info-row">
          <strong>NIP / REGON</strong>
          <span>{site.nip} / {site.regon}</span>
        </div>
        <div class="info-row">
          <strong>Telefon</strong>
          <a href={`tel:${site.phone1Href}`}>{site.phone1}</a><br />
          <a href={`tel:${site.phone2Href}`}>{site.phone2}</a>
        </div>
        <div class="info-row">
          <strong>E-mail</strong>
          <a href={`mailto:${site.email1}`}>{site.email1}</a><br />
          <a href={`mailto:${site.email2}`}>{site.email2}</a>
        </div>
        <div class="info-row">
          <strong>Strony WWW</strong>
          <a href="https://high-pres.pl">high-pres.pl</a> · <a href="https://www.mach24.pl">mach24.pl</a>
        </div>
        <div class="info-row">
          <strong>Godziny otwarcia</strong>
          <span>{site.hours}</span>
        </div>
      </div>

      <div>
        <h3 style="margin-bottom:20px">Formularz kontaktowy</h3>
        <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="REPLACE_WITH_WEB3FORMS_KEY" />
          <input type="hidden" name="subject" value="Nowe zapytanie z high-pres.pl" />
          <input type="hidden" name="from_name" value="Formularz high-pres.pl" />
          <div class="form-row">
              <label>Imię i nazwisko *<input type="text" name="imie" placeholder="np. Anna Kowalska" required /></label>
            <label>Adres e-mail *<input type="email" name="email" placeholder="np. anna@example.com" required /></label>
          </div>
          <label>Telefon<input type="tel" name="telefon" placeholder="np. 575 794 482" /></label>
          <label>Wiadomość *<textarea name="wiadomosc" rows="6" placeholder="Materiał, wymiary, ilość…" required></textarea></label>
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
          <button class="btn" type="submit">Wyślij zapytanie</button>
          <p class="form-status" aria-live="polite"></p>
          <p class="form-note">Twoje dane wykorzystamy wyłącznie do odpowiedzi na zapytanie. Wysyłając formularz, akceptujesz <a href={`${base}polityka-prywatnosci/`}>politykę prywatności</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>{k.driveTitle}</h2>
      <p class="subtitle">{k.driveSubtitle}</p>
      <div class="map-wrap">
        <iframe title="Mapa dojazdu — JET CUTTING, Niedomice" src="https://maps.google.com/maps?q=Kolejowa%2010%2C%2033-132%20Niedomice&t=&z=14&ie=UTF8&iwloc=&output=embed" width="100%" height="400" style="border:0;border-radius:12px" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://js.hcaptcha.com/1/api.js" defer></script>