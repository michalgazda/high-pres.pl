---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteRaw from '../data/site.json';
import pageRaw from '../data/wyceny.json';

const base = import.meta.env.BASE_URL;
const site = (siteRaw as any).site;
const p = (pageRaw as any).wyceny;
---

<BaseLayout
  title={`Wyceny i wycena usług cięcia wodą — ${site.companyShort}`}
  description={`Zamów bezpłatną wycenę cięcia wodą. Podaj grubość i gatunek materiału, jakość cięcia i ilość elementów. Wykonamy ofertę na podstawie rysunku, pliku lub zdjęcia. Poprzednio ${site.previousName}.`}
  canonical="https://high-pres.pl/wyceny/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Wyceny</h1>
      <p>Zamów bezpłatną wycenę usługi cięcia wodą</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {p.blocks.map((block: any) => (
        <div class="price-box">
          <h3>{block.heading}</h3>
          <ul>
            {block.items.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
          {block.footer && <p style="margin-top:12px">{block.footer}</p>}
        </div>
      ))}

      <div style="text-align:center;margin-top:36px">
        <a href={`${base}kontakt/`} class="btn btn-gold">Przejdź do formularza kontaktowego</a>
      </div>
    </div>
  </section>
</BaseLayout>
