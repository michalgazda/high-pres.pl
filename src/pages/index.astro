---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteRaw from '../data/site.json';
import pageRaw from '../data/homepage.json';

const base = import.meta.env.BASE_URL;
const site = (siteRaw as any).site;
const p = (pageRaw as any).homepage;
---

<BaseLayout
  title={`${site.companyShort} — Precyzyjne cięcie wodą | Tarnowskie Centrum Obróbki Wodą`}
  description={`Centrum obróbki wodą ${site.companyShort} w Niedomicach k. Tarnowa. Oferujemy precyzyjne cięcie wodą 2D i 3D metali, kamienia, szkła i tworzyw. Zapraszamy do kontaktu. Poprzednio ${site.previousName}.`}
  canonical="https://high-pres.pl/"
>
  <!-- Hero -->
  <section class="hero">
    <img src={`${base}images/hero-bg-1024x366-1.jpg`} alt="" class="hero-bg" aria-hidden="true" />
    <div class="container hero-content">
      <h1 set:html={p.hero.title} />
      <p>{p.hero.subtitle}</p>
      <a href={`${base}kontakt/`} class="btn btn-gold">{p.hero.cta}</a>
    </div>
  </section>

  <!-- O firmie -->
  <section class="section">
    <div class="container">
      <h2>{p.about.sectionHeading}</h2>
      <p class="subtitle">{p.about.subtitle}</p>

      <div class="two-col">
        <div>
          <h3>{p.about.heading}</h3>
          <p>{p.about.paragraph1}</p>
          <p style="margin-top:12px">{p.about.paragraph2}</p>
          <br />
          <a href={`${base}technologia/`} class="btn">{p.about.cta}</a>
        </div>
        <img src={`${base}images/baner2.jpg`} alt={p.about.imageAlt} loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Dlaczego warto -->
  <section class="section section-alt">
    <div class="container">
      <h2>{p.whyUs.heading}</h2>
      <p class="subtitle">{p.whyUs.subtitle}</p>

      <div class="features-grid">
        {p.whyUs.cards.map((card: any) => (
          <div class="card">
            <div class="card-icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Usługi w skrócie -->
  <section class="section">
    <div class="container">
      <h2>{p.servicesSummary.heading}</h2>
      <p class="subtitle">{p.servicesSummary.subtitle}</p>

      <div class="two-col two-col-reverse">
        <div>
          <ul class="check-list">
            {p.servicesSummary.items.map((item: string) => (
              <li set:html={item} />
            ))}
          </ul>
          <br />
          <a href={`${base}uslugi/`} class="btn">{p.servicesSummary.cta}</a>
        </div>
        <img src={`${base}images/macro-focus-cogwheel-gear-159275.jpeg`} alt="Precyzyjne cięcie metalu wodą" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Galerie CTA -->
  <section class="section section-alt">
    <div class="container" style="text-align:center">
      <h2>{p.galleryCta.heading}</h2>
      <p class="subtitle">{p.galleryCta.subtitle}</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:20px">
        <a href={`${base}realizacje-2d/`} class="btn">Realizacje 2D</a>
        <a href={`${base}realizacje-3d/`} class="btn">Realizacje 3D</a>
        <a href={`${base}rozety/`} class="btn btn-gold">Rozety</a>
      </div>
    </div>
  </section>

  <!-- Kontakt CTA -->
  <section class="section section-dark" style="text-align:center">
    <div class="container">
      <h2>{p.contactCta.heading}</h2>
      <p class="subtitle">{p.contactCta.subtitle}</p>
      <a href={`${base}wyceny/`} class="btn btn-gold" style="margin-top:10px">{p.contactCta.cta}</a>
    </div>
  </section>
</BaseLayout>