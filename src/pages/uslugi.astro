---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteRaw from '../data/site.json';
import pageRaw from '../data/uslugi.json';

const base = import.meta.env.BASE_URL;
const site = (siteRaw as any).site;
const p = (pageRaw as any).uslugi;
---

<BaseLayout
  title={`Usługi cięcia wodą 2D i 3D — ${site.companyShort}`}
  description={`Profesjonalne cięcie wodą: stół 4,2×2 m, grubość do 200 mm, tolerancja 0,1 mm. Cięcie 2D, 3D, grawerowanie. Tniemy stal, aluminium, kamień, szkło, tworzywa i drewno. Poprzednio ${site.previousName}.`}
  canonical="https://high-pres.pl/uslugi/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Usługi</h1>
      <p>Poznaj pełen zakres naszych usług obróbki wodą</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="price-box" style="background:var(--blue-deep);color:var(--white)">
        <h3 style="color:var(--white)">📐 Parametry techniczne</h3>
        <ul>
          <li>Stół roboczy: <strong>{p.params.table}</strong></li>
          <li>Grubość cięcia: do <strong>{p.params.thickness}</strong></li>
          <li>Tolerancja wykonania: <strong>{p.params.tolerance}</strong> cięcia</li>
          <li>5 klas jakości cięcia: {p.params.qualityClasses}</li>
          <li>{p.params.customThickness}</li>
        </ul>
      </div>

      <h2 style="margin-top:50px">Zakres usług</h2>
      <div class="features-grid" style="margin-top:24px">
        {p.services.map((svc: any) => (
          <div class="card">
            <h3>{svc.icon} {svc.title}</h3>
            <p>{svc.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Materiały, które tniemy</h2>
      <p class="subtitle">Tniemy i obrabiamy wszystkie materiały, nawet najbardziej nietypowe.</p>
      <div class="features-grid">
        {p.materials.map((mat: any) => (
          <div class="card">
            <h3>{mat.title}</h3>
            <p>{mat.text}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:36px">
        <a href={`${base}kontakt/`} class="btn btn-gold">Zapytaj o wycenę</a>
      </div>
    </div>
  </section>
</BaseLayout>