---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteRaw from '../data/site.json';
import pageRaw from '../data/technologia.json';

const base = import.meta.env.BASE_URL;
const site = (siteRaw as any).site;
const p = (pageRaw as any).technologia;
---

<BaseLayout
  title={`Technologia cięcia wodą — ${site.companyShort}`}
  description={`Poznaj zalety cięcia i obróbki wodą nowoczesnym abradżetem. Tniemy każdy materiał do grubości 200 mm — stal, aluminium, kamień, szkło, tworzywa i drewno. Poprzednio ${site.previousName}.`}
  canonical="https://high-pres.pl/technologia/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Technologia</h1>
      <p>Poznaj zalety cięcia i obróbki wodą nowoczesnym abradżetem</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="two-col">
        <div>
          <h2>{p.introHeading}</h2>
          <p>{p.introText}</p>
          <br />
          <a href={`${base}uslugi/`} class="btn">Sprawdź nasze usługi</a>
        </div>
        <img src={`${base}images/glowica.jpg`} alt="Głowica tnąca abradżetu" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>{p.advantagesHeading}</h2>
      <div style="margin-top:40px;display:grid;gap:16px;max-width:800px;margin-left:auto;margin-right:auto">
        {p.advantages.map((adv: string) => (
          <div class="price-box" set:html={adv} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Jak tniemy?</h2>
      <p class="subtitle">{p.howWeCut.subtitle}</p>
      <div class="features-grid">
        {p.howWeCut.cards.map((card: any) => (
          <div class="card">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>