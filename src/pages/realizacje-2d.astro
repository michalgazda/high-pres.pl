---
import BaseLayout from '../layouts/BaseLayout.astro';
import { realizacje2d } from "../data/galleries";
const base = import.meta.env.BASE_URL;
const imgPath = `${base}images/realizacje-2d/`;
---

<BaseLayout
  title="Realizacje cięcia 2D — JET CUTTING Adam Kołaszczyński"
  description="Galeria realizacji cięcia wodą 2D — detale płaskie, profile, wykroje. Zobacz przykłady naszych prac w stali, aluminium, kamieniu i innych materiałach. Poprzednio High Pres & Mach."
  canonical="https://high-pres.pl/realizacje-2d/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Realizacje 2D</h1>
      <p>Galeria naszych prac — cięcie płaskie</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Podgląd realizacji" aria-hidden="true">
        <button class="lb-close" id="lb-close" aria-label="Zamknij podgląd">&times;</button>
        <div class="lb-nav">
          <button id="lb-prev" aria-label="Poprzednia realizacja">‹</button>
          <button id="lb-next" aria-label="Następna realizacja">›</button>
        </div>
        <img id="lb-img" src="" alt="Podgląd realizacji" />
      </div>

      <div data-gallery class="gallery-grid">
        {realizacje2d.map((f) => (
          <a href={imgPath + f} title={`Realizacja cięcia wodą 2D — ${f}`}>
            <img src={imgPath + f} alt={`Realizacja cięcia wodą 2D — ${f}`} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>